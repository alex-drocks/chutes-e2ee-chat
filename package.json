{
  "name": "chutes-e2ee-chat",
  "version": "0.1.0",
  "description": "Electron + Next.js + Tailwind chat app with Chutes.ai E2EE",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "cd renderer && next dev -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "cd renderer && next build",
    "build": "npm run build:renderer",
    "start": "electron .",
    "postinstall": "cd renderer && npm install",
    "test:unit": "node --test tests/protocol.regression.test.js tests/crypto.unit.test.js tests/retry.unit.test.js",
    "test:live": "node --test tests/e2ee-integration.test.js tests/cors-free.test.js tests/e2ee-comprehensive.test.js tests/e2ee-stress.test.js",
    "test": "npm run test:unit && npm run test:live"
  },
  "dependencies": {
    "electron": "^41.3.0",
    "mlkem": "^2.7.0",
    "@stablelib/chacha20poly1305": "^2.0.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.5"
  }
}
