{
  "name": "chutes-e2ee-chat",
  "version": "0.1.0",
  "description": "Secure Electron + Next.js chat client for Chutes.ai E2EE inference.",
  "license": "MIT",
  "author": "alex-drocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-drocks/chutes-e2ee-chat.git"
  },
  "bugs": {
    "url": "https://github.com/alex-drocks/chutes-e2ee-chat/issues"
  },
  "homepage": "https://github.com/alex-drocks/chutes-e2ee-chat#readme",
  "keywords": [
    "electron",
    "nextjs",
    "chutes",
    "e2ee",
    "post-quantum",
    "ml-kem",
    "chat"
  ],
  "main": "electron.js",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22"
  },
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "dev:renderer": "bun run --cwd renderer dev",
    "dev:electron": "wait-on http://localhost:3000 && node scripts/run-electron.mjs --renderer-url=http://localhost:3000 .",
    "dev": "concurrently \"bun run dev:renderer\" \"bun run dev:electron\"",
    "build:renderer": "bun run --cwd renderer build",
    "build": "bun run build:renderer",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder --win --x64",
    "start": "node scripts/run-electron.mjs .",
    "test": "bun test",
    "test:ci": "bun test tests/protocol.regression.test.js tests/crypto.unit.test.js tests/retry.unit.test.js tests/discovery.unit.test.js",
    "test:unit": "bun test tests/protocol.regression.test.js tests/crypto.unit.test.js tests/retry.unit.test.js tests/discovery.unit.test.js",
    "test:live": "RUN_LIVE_TESTS=1 bun test --timeout 30000 --max-concurrency=1 tests/e2ee-integration.test.js tests/e2ee-comprehensive.test.js tests/e2ee-stress.test.js tests/cors-free.test.js"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "mlkem": "^2.7.0",
    "@stablelib/chacha20poly1305": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "wait-on": "^9.0.10",
    "electron-builder": "26.0.12",
    "electron-builder-squirrel-windows": "26.0.12"
  },
  "overrides": {
    "tar": "7.5.19",
    "form-data": "4.0.6",
    "axios": "1.18.1",
    "joi": "18.2.3",
    "shell-quote": "1.9.0",
    "postcss": "8.5.16",
    "dompurify": "3.4.11",
    "uuid": "14.0.1",
    "mermaid": "11.16.0",
    "electron-builder-squirrel-windows": "26.0.12"
  },
  "build": {
    "appId": "com.chutes.e2eechat",
    "productName": "Chutes E2EE Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron.js",
      "preload.js",
      "lib/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
